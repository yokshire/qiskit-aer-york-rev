include MANIFEST.in
include README.md
include YORK_REVISION.md
include tools/york_build.py
include tools/york_build.sh
include tools/york-build-requirements.txt
include tools/york_ci.py
include tools/york_smoke.py
include tools/york_plugin_ci.py
include tools/york_accelerator_smoke.py
include tools/york_modular_ci.py
include tools/york_modular_gpu_smoke.py
include tools/york_nature_smoke.py
include NATURE_COMPATIBILITY.md
include MODULAR_ARCHITECTURE.md
graft core
graft integrations
graft engines
graft drivers
graft test/modular
prune core/build
prune integrations/qiskit/build
prune integrations/nature/build
prune drivers/pyscf/build
prune engines/statevector/build
prune engines/native/build
prune core/src/qiskit_aer_york_core.egg-info
prune integrations/qiskit/src/qiskit_aer_york_qiskit.egg-info
prune integrations/nature/src/qiskit_aer_york_nature.egg-info
prune drivers/pyscf/src/qiskit_aer_york_pyscf.egg-info
prune engines/statevector/src/qiskit_aer_york_statevector.egg-info
prune engines/native/src/qiskit_aer_york_native.egg-info
graft accelerators
prune accelerators/opencl/build
prune accelerators/cupy/build
prune accelerators/opencl/src/qiskit_aer_york_opencl.egg-info
prune accelerators/cupy/src/qiskit_aer_york_cupy.egg-info
global-exclude *.py[cod]
graft test/accelerators
include pyproject.toml
recursive-include qiskit_aer *cpp
recursive-include qiskit_aer *hpp
graft src
graft contrib
include qiskit_aer/backends/wrappers/CMakeLists.txt
include qiskit_aer/backends/wrappers/bindings.cc
include qiskit_aer/VERSION.txt
include qiskit_aer/library/instructions_table.csv
include CMakeLists.txt
include cmake/*.cmake
# Exclude static libraries (they are all compressed with 7z)
exclude src/third-party/*/lib/*.a
exclude src/third-party/*/lib/*.lib
